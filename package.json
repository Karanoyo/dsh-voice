{
  "name": "dsh-voice",
  "version": "0.1.0",
  "description": "语音转文字插件（DeepSeek Harness / dsh）：输入框右下角麦克风按钮，三种识别引擎（浏览器自带 / 讯飞 / 本地 Whisper）可切换。",
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlie-pan/dsh-voice.git"
  },
  "homepage": "https://github.com/charlie-pan/dsh-voice#readme",
  "engines": { "node": ">=20" },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "speech-to-text",
    "voice",
    "whisper",
    "xfyun",
    "webspeech",
    "voice-input"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
