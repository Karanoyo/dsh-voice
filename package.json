{
  "name": "dsh-voice",
  "version": "2.1.1",
  "description": "语音转文字插件 V2（DeepSeek Harness / dsh）：输入框右下角麦克风按钮，讯飞识别引擎（需注册 API）",
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "./locale/*.json",
    "icon.svg",
    "images"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlie-pan/dsh-voice.git"
  },
  "homepage": "https://github.com/charlie-pan/dsh-voice#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "speech-to-text",
    "voice",
    "whisper",
    "xfyun",
    "webspeech",
    "voice-input"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
